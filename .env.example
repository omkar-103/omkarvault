# ==============================================================
# Omkar Vault — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file with real credentials.
# ==============================================================

# ── Supabase ───────────────────────────────────────────────
# Your Supabase project URL (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key (safe in frontend if needed)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# SECRET service-role key — SERVER ONLY, NEVER expose to browser
SUPABASE_SECRET_KEY=your_server_only_secret_service_role_key_here

# ── Database ────────────────────────────────────────────────
# Supabase PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Auth / Session ──────────────────────────────────────────
# Administrator vault password (plain-text here, hashed at runtime)
VAULT_ADMIN_PASSWORD=your_admin_password_here

# Random secret for signing session tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_session_signing_secret_here

# ── Storage ─────────────────────────────────────────────────
# Supabase Storage bucket name
STORAGE_BUCKET=omkarvault

# ── Limits ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
SESSION_DURATION_HOURS=24

# ── Optional ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
